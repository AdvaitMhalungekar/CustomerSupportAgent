# Groq Free Tier API Key (Required for live LLM and Whisper ASR)
# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Fast and Escalation Models (OpenAI-compatible Groq endpoint)
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_ESCALATION_MODEL=openai/gpt-oss-120b

# Audio & Turn Detection
USE_SEMANTIC_TURN_DETECTOR=false
SILENCE_TIMEOUT_MS=600

# Observability (Arize Phoenix)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=ai-adventures-voice-support
